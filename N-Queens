n = 4
board = [-1]*n

def solve(row):
    if row == n:
        print(board)
        return True

    for col in range(n):
        ok = True

        for i in range(row):
            if board[i] == col or abs(board[i]-col) == row-i:
                ok = False

        if ok:
            board[row] = col

            if solve(row+1):
                return True

    return False

solve(0)
