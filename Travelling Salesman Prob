from itertools import permutations

cost = [
[0,10,15,20],
[10,0,35,25],
[15,35,0,30],
[20,25,30,0]
]

best = 9999

for p in permutations([1,2,3]):

    total = cost[0][p[0]]
    total += cost[p[0]][p[1]]
    total += cost[p[1]][p[2]]
    total += cost[p[2]][0]

    if total < best:
        best = total

print("Minimum cost =",best)
