graph = [
    [0,1,1],
    [1,0,1],
    [1,1,0]
]

color = [0,0,0]
m = 3

for v in range(3):
    for c in range(1,m+1):
        ok = True

        for i in range(3):
            if graph[v][i] and color[i] == c:
                ok = False

        if ok:
            color[v] = c
            break

print(color)
