graph = [
    [0,2,3],
    [2,0,1],
    [3,1,0]
]

n = 3
selected = [False]*n
selected[0] = True

for k in range(n-1):
    mn = 999
    x = y = 0

    for i in range(n):
        if selected[i]:
            for j in range(n):
                if not selected[j] and graph[i][j] < mn:
                    mn = graph[i][j]
                    x,y = i,j

    print(x,"-",y,"=",mn)
    selected[y] = True
